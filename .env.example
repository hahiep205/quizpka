VITE_SUPABASE_URL=https://<project-ref>.supabase.co
VITE_SUPABASE_ANON_KEY=
# Same-origin proxy /sb mặc định TẮT (thực nghiệm: Supabase gateway không nhận
# được IP client qua Vercel rewrite → rate-limit theo IP bị gộp chung). Chỉ đặt
# biến này khi đã có cơ chế truyền IP client đáng tin; "off" = tắt rõ ràng.
VITE_SUPABASE_PROXY_URL=
