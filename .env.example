VITE_SUPABASE_URL=https://<project-ref>.supabase.co
VITE_SUPABASE_ANON_KEY=
# Tùy chọn: kiểm soát same-origin proxy /sb (vercel.json rewrite) để bỏ CORS
# preflight. Mặc định (bỏ trống): host https tự dùng `${origin}/sb`, local dev
# gọi thẳng. Đặt absolute URL để ép proxy khác; đặt "off" để tắt proxy trên
# https (cần build lại).
VITE_SUPABASE_PROXY_URL=
